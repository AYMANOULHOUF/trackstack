# Copy to .env and fill in before running: docker compose up --build
# Never commit .env to version control.

# Postgres password (used by the db container and the API's DATABASE_URL).
DB_PASSWORD=change_me_strong_password

# Host port for Postgres (default 5433).
# DB_PORT=5433

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret

# Global admin account seeded/updated on every API boot, so changing
# ADMIN_PASSWORD here and restarting the API updates the existing login.
# ADMIN_EMAIL defaults to admin@trackstack.local when omitted.
ADMIN_EMAIL=admin@trackstack.local
ADMIN_PASSWORD=change_me_admin_password

# ---------------------------------------------------------------------------
# Hardware gateway
# ---------------------------------------------------------------------------

# Shared secret between protocol-gateway and api-service. Leave empty to keep
# hardware ingest disabled. Generate with: openssl rand -hex 32
GATEWAY_SECRET=

# Host port for GT06/Concox trackers (default 5023).
# GT06_PORT=5023

# ---------------------------------------------------------------------------
# Trips
# ---------------------------------------------------------------------------

# How often the trip segmentation worker runs (Go duration, e.g. 30s, 2m).
# TRIP_WORKER_INTERVAL=30s

# ---------------------------------------------------------------------------
# Notifications (both optional — the channel stays inert until configured)
# ---------------------------------------------------------------------------

# Email: SMTP_ADDR is host:port; port 465 uses implicit TLS, otherwise STARTTLS.
# SMTP_ADDR=smtp.example.com:587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com

# Web Push: generate a key pair with `go run ./cmd/vapid` in backend/api-service.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
